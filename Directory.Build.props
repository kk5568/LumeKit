<Project>
  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <LumeKitVersion>2026.11.12.17.37</LumeKitVersion>
    <LumeKitPackageVersion>26.11.12.1737</LumeKitPackageVersion>
