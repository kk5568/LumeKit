<UserControl
    x:Class="BluetoothAudioReceiver.DeskBoxFloating.Views.DeskBoxIslandStatusContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="Black" CornerRadius="28" Padding="16,0">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Status.IconGlyph, Mode=OneWay}"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="18"
                      Foreground="White"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind Status.Title, Mode=OneWay}"
                       Foreground="White"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="{x:Bind Status.Summary, Mode=OneWay}"
                       Foreground="#C8C8C8"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
