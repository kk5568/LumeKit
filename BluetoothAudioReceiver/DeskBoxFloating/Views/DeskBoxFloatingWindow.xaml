<windowex:WindowEx
    x:Class="BluetoothAudioReceiver.DeskBoxFloating.Views.DeskBoxFloatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="250"
    Height="54"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer"
          Background="Transparent"
          Opacity="1">
        <Grid x:Name="WidgetShellRoot"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5">

            <!-- Visuals are resolved in code by ApplySurfaceStyle, matching DeskBox
                 WidgetShell.xaml: the plate only paints in Solid mode; every other
                 material leaves it transparent so the system backdrop shows through. -->
            <Border x:Name="BackgroundPlate"
                    BorderThickness="0"
                    CornerRadius="0" />

            <!-- 统一布局：标题和正文合成一整块，在窗口里垂直居中，不再分两行、不再画分隔线。
                 窗口高度由 MeasureFittedHeight 按这块的实际高度算。 -->
            <Grid x:Name="ContentBlock"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBarGrid"
                      Grid.Row="0"
                      Padding="{StaticResource DeskBoxFloatingPadding}"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ColumnSpacing="{StaticResource DeskBoxFloatingContentSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="{StaticResource DeskBoxFloatingIconBoxSize}"
                          Height="{StaticResource DeskBoxFloatingIconBoxSize}"
                          VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource DeskBoxFloatingIconFontSize}"
                                   Foreground="{ThemeResource DeskBoxFloatingTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="&#xE765;" />
                    </Grid>

                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               FontFamily="{StaticResource DeskBoxFloatingFontFamily}"
                               FontSize="{StaticResource DeskBoxFloatingTextFontSize}"
                               Foreground="{ThemeResource DeskBoxFloatingTextBrush}"
                               Text="测试"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="StatusText"
                               Grid.Column="2"
                               FontFamily="{StaticResource DeskBoxFloatingFontFamily}"
                               FontSize="{StaticResource DeskBoxFloatingTextFontSize}"
                               Foreground="{ThemeResource DeskBoxFloatingSecondaryTextBrush}"
                               Text="已触发"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 旧设计（统一布局开关关闭时才显示）：DeskBox WidgetShell.xaml:184-190 的标题分隔线。 -->
                <Border x:Name="HeaderDivider"
                        Grid.Row="0"
                        Height="1"
                        Margin="12,0,12,4"
                        Opacity="0.62"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource DeskBoxFloatingDividerBrush}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />

                <Grid x:Name="ContentTransitionViewport"
                      Grid.Row="1"
                      Padding="{StaticResource DeskBoxFloatingBodyPadding}"
                      Background="Transparent">
                    <Grid x:Name="ShellContentPresenter"
                          RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="DescriptionText"
                                   Grid.Row="0"
                                   FontFamily="{StaticResource DeskBoxFloatingFontFamily}"
                                   FontSize="{StaticResource DeskBoxFloatingDescriptionFontSize}"
                                   Foreground="{ThemeResource DeskBoxFloatingSecondaryTextBrush}"
                                   Text=""
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center" />

                        <ScrollViewer x:Name="ItemsScrollViewer"
                                      Grid.Row="1"
                                      MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">
                            <StackPanel x:Name="PreviewItemsPanel"
                                        Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="FeedbackLayer"
                  Margin="12"
                  IsHitTestVisible="False" />
        </Grid>
    </Grid>
</windowex:WindowEx>
