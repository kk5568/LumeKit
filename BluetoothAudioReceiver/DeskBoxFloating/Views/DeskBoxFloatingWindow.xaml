<windowex:WindowEx
    x:Class="BluetoothAudioReceiver.DeskBoxFloating.Views.DeskBoxFloatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="250"
    Height="54"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer"
          Background="Transparent"
          Opacity="1">
        <Grid x:Name="WidgetShellRoot"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"
                               MinHeight="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="BackgroundPlate"
                    Grid.RowSpan="2"
                    Background="{ThemeResource DeskBoxFloatingSurfaceBrush}"
                    BorderBrush="{ThemeResource DeskBoxFloatingStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource DeskBoxFloatingCornerRadius}" />

            <Grid x:Name="TitleBarGrid"
                  Grid.Row="0"
                  Padding="{StaticResource DeskBoxFloatingPadding}"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  ColumnSpacing="{StaticResource DeskBoxFloatingContentSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="{StaticResource DeskBoxFloatingIconBoxSize}"
                      Height="{StaticResource DeskBoxFloatingIconBoxSize}"
                      VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="{StaticResource DeskBoxFloatingIconFontSize}"
                               Foreground="{ThemeResource DeskBoxFloatingTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="" />
                </Grid>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           FontFamily="{StaticResource DeskBoxFloatingFontFamily}"
                           FontSize="{StaticResource DeskBoxFloatingTextFontSize}"
                           Foreground="{ThemeResource DeskBoxFloatingTextBrush}"
                           Text="测试"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           FontFamily="{StaticResource DeskBoxFloatingFontFamily}"
                           FontSize="{StaticResource DeskBoxFloatingTextFontSize}"
                           Foreground="{ThemeResource DeskBoxFloatingSecondaryTextBrush}"
                           Text="已触发"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="HeaderDivider"
                    Grid.Row="0"
                    Height="1"
                    Margin="12,0,12,0"
                    Opacity="0.45"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource DeskBoxFloatingStrokeBrush}" />

            <Grid x:Name="ContentTransitionViewport"
                  Grid.Row="1"
                  Padding="{StaticResource DeskBoxFloatingBodyPadding}"
                  Background="Transparent">
                <Grid x:Name="ShellContentPresenter"
                      RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <TextBlock x:Name="DescriptionText"
                           Grid.Row="0"
                           FontFamily="{StaticResource DeskBoxFloatingFontFamily}"
                           FontSize="{StaticResource DeskBoxFloatingDescriptionFontSize}"
                           Foreground="{ThemeResource DeskBoxFloatingSecondaryTextBrush}"
                           Text=""
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Visibility="Collapsed"
                           VerticalAlignment="Center" />

                <ScrollViewer x:Name="ItemsScrollViewer"
                              Grid.Row="1"
                              MaxHeight="220"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="PreviewItemsPanel"
                                Spacing="4" />
                </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="FeedbackLayer"
                  Grid.RowSpan="2"
                  Margin="12"
                  IsHitTestVisible="False" />
            </Grid>
    </Grid>
</windowex:WindowEx>
