<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WidgetOverlaySurfaceBrush" Color="#FBFCFD" />
            <SolidColorBrush x:Key="WidgetOverlayStrokeBrush" Color="#24000000" />
            <SolidColorBrush x:Key="DeskBoxFloatingSurfaceBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="DeskBoxFloatingTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DeskBoxFloatingSecondaryTextBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="DeskBoxFloatingStrokeBrush" Color="#24000000" />
            <SolidColorBrush x:Key="DeskBoxFloatingDividerBrush" Color="#0A000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WidgetOverlaySurfaceBrush" Color="#2A3038" />
            <SolidColorBrush x:Key="WidgetOverlayStrokeBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="DeskBoxFloatingSurfaceBrush" Color="#802A3038" />
            <SolidColorBrush x:Key="DeskBoxFloatingTextBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="DeskBoxFloatingSecondaryTextBrush" Color="#A5A5A5" />
            <SolidColorBrush x:Key="DeskBoxFloatingStrokeBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="DeskBoxFloatingDividerBrush" Color="#10FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="DeskBoxFloatingFontFamily">Microsoft YaHei UI, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="DeskBoxMenuFontFamily">Microsoft YaHei UI, Segoe UI Variable, Segoe UI</FontFamily>
    <CornerRadius x:Key="DeskBoxFloatingCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="WidgetCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="WidgetCornerRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="WidgetCornerRadiusLarge">8</CornerRadius>
    <Thickness x:Key="DeskBoxFloatingPadding">14,0,14,0</Thickness>
    <Thickness x:Key="DeskBoxFloatingBodyPadding">14,0,14,12</Thickness>
    <Thickness x:Key="DeskBoxMenuPresenterPadding">0,4,0,4</Thickness>
    <Thickness x:Key="DeskBoxMenuItemPadding">10,8,10,8</Thickness>
    <x:Double x:Key="DeskBoxMenuItemMinHeight">36</x:Double>
    <x:Double x:Key="DeskBoxMenuItemFontSize">13</x:Double>
    <x:Double x:Key="DeskBoxFloatingWidth">250</x:Double>
    <x:Double x:Key="DeskBoxFloatingHeight">54</x:Double>
    <x:Double x:Key="DeskBoxFloatingPanelWidth">360</x:Double>
    <x:Double x:Key="DeskBoxFloatingPanelHeight">126</x:Double>
    <x:Double x:Key="DeskBoxFloatingMenuWidth">220</x:Double>
    <x:Double x:Key="DeskBoxFloatingMenuHeight">178</x:Double>
    <x:Double x:Key="DeskBoxFloatingIconBoxSize">26</x:Double>
    <x:Double x:Key="DeskBoxFloatingIconFontSize">14</x:Double>
    <x:Double x:Key="DeskBoxFloatingTextFontSize">13</x:Double>
    <x:Double x:Key="DeskBoxFloatingDescriptionFontSize">12</x:Double>
    <x:Double x:Key="DeskBoxFloatingContentSpacing">10</x:Double>
    <Thickness x:Key="DeskBoxFloatingTallPadding">14,12,14,12</Thickness>
</ResourceDictionary>
