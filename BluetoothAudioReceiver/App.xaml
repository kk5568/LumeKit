<Application
    x:Class="BluetoothAudioReceiver.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Note: Don't include this in other resource dictionaries!  -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Control Styles  -->
                <ResourceDictionary Source="/Styles/Controls.xaml" />
                <!--  Values  -->
                <ResourceDictionary Source="/Styles/Values.xaml" />
                <!--  Shared floating menu style based on the DeskBox reference project.  -->
                <ResourceDictionary Source="/Styles/DeskBoxMenuResources.xaml" />
                <!--  New independent DeskBox floating surface design.  -->
                <ResourceDictionary Source="/DeskBoxFloating/Resources/DeskBoxFloatingResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  NavigationView 内容区域底板：保持透明，避免页面中间多一层深色背景。 -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
