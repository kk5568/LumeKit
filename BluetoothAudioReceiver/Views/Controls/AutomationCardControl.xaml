<UserControl
    x:Class="BluetoothAudioReceiver.Views.Controls.AutomationCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Style="{StaticResource SharedFeatureCardShellStyle}">
        <Grid RowSpacing="{StaticResource SharedFeatureCardRowSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource SharedFeatureCardHeaderGridLength}" />
                <RowDefinition Height="{StaticResource SharedFeatureCardDividerGridLength}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource SharedFeatureCardDividerGridLength}" />
                <RowDefinition Height="{StaticResource SharedFeatureCardFooterGridLength}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource SharedFeatureCardBadgeTextStyle}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{Binding EnabledText}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  MinWidth="0"
                                  Margin="0"
                                  Padding="0"
                                  OnContent=""
                                  OffContent="" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Style="{StaticResource SharedFeatureCardDividerStyle}" />

            <StackPanel Grid.Row="2"
                        VerticalAlignment="Top"
                        Spacing="6">
                <TextBlock Text="{Binding TriggerText}"
                           Style="{StaticResource SharedFeatureCardTitleStyle}" />
                <TextBlock Text="{Binding StatusLineText}"
                           Style="{StaticResource SharedFeatureCardStatusTextStyle}" />
                <TextBlock Text="{Binding LastRunText}"
                           Style="{StaticResource SharedFeatureCardStatusTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Style="{StaticResource SharedFeatureCardActionPanelStyle}">
                <Button Content="编辑" HorizontalContentAlignment="Center" Click="OnEditClick" />
                <Button Content="{Binding TestButtonText}"
                        IsEnabled="{Binding CanTest}"
                        HorizontalContentAlignment="Center"
                        Click="OnTestClick" />
                <Button Content="删除" HorizontalContentAlignment="Center" Click="OnDeleteClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
