<UserControl
    x:Class="BluetoothAudioReceiver.Views.Controls.HotkeyBindingCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BluetoothAudioReceiver.Converters"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages">

    <UserControl.Resources>
        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
    </UserControl.Resources>

    <Grid Width="286" Style="{StaticResource SharedFeatureCardShellStyle}">
        <Grid RowSpacing="{StaticResource SharedFeatureCardRowSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource SharedFeatureCardHeaderGridLength}" />
                <RowDefinition Height="{StaticResource SharedFeatureCardDividerGridLength}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource SharedFeatureCardDividerGridLength}" />
                <RowDefinition Height="{StaticResource SharedFeatureCardFooterGridLength}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SharedFeatureCardHeaderColumnSpacing}">
                <TextBlock Text="{Binding HotkeyDisplay}"
                           Style="{StaticResource SharedFeatureCardBadgeTextStyle}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{Binding EnabledText}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  OnContent=""
                                  OffContent=""
                                  MinWidth="0"
                                  Margin="0"
                                  Padding="0" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Style="{StaticResource SharedFeatureCardDividerStyle}" />

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DeviceLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:DeviceLineItem">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Left"
                                        Margin="0,5,0,5"
                                        Opacity="{x:Bind IsAvailable, Mode=OneWay, Converter={StaticResource BooleanToOpacityConverter}}">
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneTime}"
                                          FontFamily="Segoe Fluent Icons"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="196" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="4" Style="{StaticResource SharedFeatureCardActionPanelStyle}">
                <Button Content="编辑" HorizontalContentAlignment="Center" Click="OnEditClick" />
                <Button Content="删除" HorizontalContentAlignment="Center" Click="OnDeleteClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
