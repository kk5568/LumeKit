<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.BackgroundTasksHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="后台任务"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:BackgroundTasksHubPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,16,24,24"
                    Spacing="8">
            <Button Click="BackgroundEfficiencyEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE71D;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="节能"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="查看后台运行策略、效率模式以及进程白名单相关配置。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Click="ThemeManagementEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE790;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="深色模式"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="启用深色模式，并按日出日落时间自动切换。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Click="AutoBrightnessEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE706;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="自动亮度"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="根据环境光或时间自动调整屏幕亮度。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
