<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.AudioNotificationHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="音频与通知"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:AudioNotificationHubPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="HubItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorTertiaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,16,24,24"
                    Spacing="8">
            <Button Click="BluetoothEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE7F5;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="音频管理"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="蓝牙音频、连接行为和基础音量设置。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Click="NotificationEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE7F4;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="悬浮通知"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="管理提示出现条件，以及游戏、全屏和录屏场景行为。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Click="HotkeyNotificationEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE765;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="按键通知"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="配置快捷键反馈、按键弹窗和相关提示行为。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
