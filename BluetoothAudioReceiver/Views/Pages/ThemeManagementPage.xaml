<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.ThemeManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="深色模式"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:ThemeManagementPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <CornerRadius x:Key="ThemeMgmtCardCornerRadius">4</CornerRadius>
        <Thickness x:Key="ThemeMgmtPageMargin">24</Thickness>
        <Thickness x:Key="ThemeMgmtCardPadding">12</Thickness>
        <x:Double x:Key="ThemeMgmtSectionTitleFontSize">16</x:Double>
        <x:Double x:Key="ThemeMgmtBodyFontSize">14</x:Double>
        <x:Double x:Key="ThemeMgmtHeaderSpacing">8</x:Double>
        <x:Double x:Key="ThemeMgmtRowSpacing">10</x:Double>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ThemeMgmtPageMargin}"
                    Spacing="12">
            <TextBlock Text="深色模式"
                       Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:SettingsCard HorizontalContentAlignment="Left"
                                       ContentAlignment="Vertical"
                                       VerticalAlignment="Stretch">
                    <Grid HorizontalAlignment="Left"
                          ColumnSpacing="{StaticResource ThemeMgmtHeaderSpacing}"
                          RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="当前数据来源" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentDataSourceText, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Text="当前系统主题" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CurrentSystemThemeText, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Text="主题修正" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.TimeCorrectionText, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Text="最后修正时间" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.LastCorrectionTimeText, Mode=OneWay}" />
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard Grid.Column="1"
                                       HorizontalContentAlignment="Left"
                                       ContentAlignment="Vertical"
                                       VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Left" Spacing="8">
                        <Grid HorizontalAlignment="Left"
                              ColumnSpacing="{StaticResource ThemeMgmtHeaderSpacing}"
                              RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Windows 计划任务" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaskSchedulerStatusText, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Text="浅色切换时间" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ScheduledSunriseText, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Text="深色切换时间" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ScheduledSunsetText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="最近执行记录" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.RecentTaskExecutionText, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </controls:SettingsCard>
            </Grid>

            <controls:SettingsCard Header="启用自动日夜切换"
                                   Description="按所选时间来源自动切换系统深浅色主题。">
                <ToggleSwitch IsOn="{x:Bind ViewModel.AutoDayNightEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="昼夜时间"
                                   Description="{x:Bind ViewModel.AutoDayNightSunTimesText, Mode=OneWay}" />

            <controls:SettingsCard Header="使用系统定位">
                <ToggleSwitch IsOn="{x:Bind ViewModel.AutoDayNightUseSystemLocation, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="Windows Night light"
                                   Description="开启时切换深色，关闭时切换浅色。">
                <ToggleSwitch IsOn="{x:Bind ViewModel.AutoDayNightUseNightLight, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="城市">
                <StackPanel Spacing="8">
                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoDayNightUseCity, Mode=TwoWay}" />
                    <Grid ColumnSpacing="{StaticResource ThemeMgmtHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.AutoDayNightCityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="上海" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="清空" MinWidth="80" Command="{x:Bind ViewModel.ClearCityCommand}" />
                        <Button Content="保存" MinWidth="80" Command="{x:Bind ViewModel.SaveCityCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Header="自定义夜间模式"
                                   Description="{x:Bind ViewModel.AutoDayNightNightScheduleText, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoDayNightUseCustomNightSchedule, Mode=TwoWay}" />
                        <Grid ColumnSpacing="{StaticResource ThemeMgmtHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="开始时间" VerticalAlignment="Center" />
                        <TimePicker Grid.Column="1" SelectedTime="{x:Bind ViewModel.AutoDayNightNightStartTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinuteIncrement="1" />
                        <TextBlock Grid.Column="2" Text="结束时间" VerticalAlignment="Center" />
                        <TimePicker Grid.Column="3" SelectedTime="{x:Bind ViewModel.AutoDayNightNightEndTime, Mode=TwoWay}" HorizontalAlignment="Stretch" MinuteIncrement="1" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="清空" MinWidth="80" Command="{x:Bind ViewModel.ClearNightScheduleCommand}" />
                        <Button Content="保存" MinWidth="80" Command="{x:Bind ViewModel.SaveNightScheduleCommand}" />
                        </StackPanel>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Header="30 秒反转测试"
                                   Description="{x:Bind ViewModel.ThemeTestStatusText, Mode=OneWay}">
                <Button Content="30秒后切换" MinWidth="112"
                        Command="{x:Bind ViewModel.StartThirtySecondThemeFlipTestCommand}" />
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
