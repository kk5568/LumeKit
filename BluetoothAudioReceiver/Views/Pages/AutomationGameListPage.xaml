<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.AutomationGameListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="程序清单"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutomationGameListPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <CornerRadius x:Key="ProgramListCardCornerRadius">4</CornerRadius>
        <Thickness x:Key="ProgramListPageMargin">24</Thickness>
        <Thickness x:Key="ProgramListCardPadding">12</Thickness>
        <x:Double x:Key="ProgramListSectionTitleFontSize">16</x:Double>
        <x:Double x:Key="ProgramListBodyFontSize">14</x:Double>
        <x:Double x:Key="ProgramListRowSpacing">8</x:Double>
        <x:Double x:Key="ProgramListHeaderSpacing">8</x:Double>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource ProgramListPageMargin}"
                    Spacing="12">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ProgramListCardCornerRadius}"
                    Padding="{StaticResource ProgramListCardPadding}">
                <StackPanel Spacing="{StaticResource ProgramListRowSpacing}">
                    <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource ProgramListSectionTitleFontSize}"
                               FontWeight="SemiBold" />

                    <Button Content="扫描安装程序"
                            MinWidth="120"
                            HorizontalAlignment="Right"
                            Click="OnScanInstalledProgramsClick" />

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="{x:Bind ViewModel.OverviewText, Mode=OneWay}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource ProgramListBodyFontSize}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ProgramListCardCornerRadius}"
                        Padding="{StaticResource ProgramListCardPadding}">
                    <StackPanel Spacing="{StaticResource ProgramListRowSpacing}">
                        <TextBlock Text="{x:Bind ViewModel.DefaultListTitleText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource ProgramListSectionTitleFontSize}"
                                   FontWeight="SemiBold" />

                        <Button Content="添加程序"
                                MinWidth="96"
                                HorizontalAlignment="Right"
                                Click="OnAddDefaultProgramClick" />

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.DefaultListInstructionText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource ProgramListBodyFontSize}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind ViewModel.DefaultProgramsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 MinHeight="220"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <Grid ColumnSpacing="{StaticResource ProgramListHeaderSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.DefaultProgramsPreviewText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource ProgramListBodyFontSize}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.RestoreButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnRestoreDefaultClick" />

                            <Button Grid.Column="2"
                                    Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnSaveClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ProgramListCardCornerRadius}"
                        Padding="{StaticResource ProgramListCardPadding}">
                    <StackPanel Spacing="{StaticResource ProgramListRowSpacing}">
                        <TextBlock Text="{x:Bind ViewModel.GameListTitleText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource ProgramListSectionTitleFontSize}"
                                   FontWeight="SemiBold" />

                        <Button Content="添加程序"
                                MinWidth="96"
                                HorizontalAlignment="Right"
                                Click="OnAddGameProgramClick" />

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.GameListInstructionText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource ProgramListBodyFontSize}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind ViewModel.GameProgramsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 MinHeight="220"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <Grid ColumnSpacing="{StaticResource ProgramListHeaderSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.GameProgramsPreviewText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource ProgramListBodyFontSize}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.RestoreButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnRestoreDefaultClick" />

                            <Button Grid.Column="2"
                                    Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnSaveClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
