<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.AutomationListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:cardControls="using:BluetoothAudioReceiver.Views.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="自动化管理"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutomationListPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <x:Double x:Key="AutomationListPageSectionSpacing">16</x:Double>
        <x:Double x:Key="AutomationListPageActionButtonSpacing">8</x:Double>
        <Thickness x:Key="AutomationListPageEmptyStatePadding">24</Thickness>
        <CornerRadius x:Key="AutomationListPageEmptyStateCornerRadius">16</CornerRadius>
        <x:Double x:Key="AutomationListPageEmptyStateOpacity">0.72</x:Double>

        <Style x:Key="AutomationEmptyStateBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource AutomationListPageEmptyStatePadding}" />
            <Setter Property="CornerRadius" Value="{StaticResource AutomationListPageEmptyStateCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="AutomationEmptyStateTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{StaticResource AutomationListPageEmptyStateOpacity}" />
        </Style>

    </Page.Resources>

    <ScrollViewer Padding="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource AutomationListPageSectionSpacing}">
            <controls:SettingsCard Header="悬浮通知">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.AutomationExecutionNotificationEnabledText, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AutomationExecutionNotificationEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  OnContent=""
                                  OffContent="" />
                </StackPanel>
            </controls:SettingsCard>

            <Button Content="添加"
                    Click="OnAddCardClick"
                    Width="84"
                    HorizontalAlignment="Right" />

            <Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Automations, Mode=OneWay}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AutomationListItem">
                            <cardControls:AutomationCardControl
                                EditClicked="OnEditCardClick"
                                TestClicked="OnTestCardClick"
                                DeleteClicked="OnDeleteCardClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Style="{StaticResource AutomationEmptyStateBorderStyle}"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                    <TextBlock Text="暂无自动化，点击“添加”创建。"
                               Style="{StaticResource AutomationEmptyStateTextStyle}" />
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
