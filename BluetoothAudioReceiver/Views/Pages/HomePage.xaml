<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:cardControls="using:BluetoothAudioReceiver.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="主页"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:HomePageViewModel}"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <x:Double x:Key="HomePageSectionSpacing">24</x:Double>
        <x:Double x:Key="HomePageSectionHeaderSpacing">10</x:Double>
        <Thickness x:Key="HomePageEmptyStatePadding">24</Thickness>
        <CornerRadius x:Key="HomePageEmptyStateCornerRadius">16</CornerRadius>
        <x:Double x:Key="HomePageEmptyStateOpacity">0.72</x:Double>

        <Style x:Key="HomeSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HomeEmptyStateBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource HomePageEmptyStatePadding}" />
            <Setter Property="CornerRadius" Value="{StaticResource HomePageEmptyStateCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="HomeEmptyStateTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{StaticResource HomePageEmptyStateOpacity}" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource HomePageSectionSpacing}">

            <StackPanel Spacing="{StaticResource HomePageSectionHeaderSpacing}">
                <TextBlock Text="LumeKit 运行看板"
                           FontSize="22"
                           FontWeight="SemiBold" />

                <Border Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="20">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RuntimeModules, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:RuntimeModuleStatusItem">
                                    <StackPanel Width="150" Spacing="8" Margin="0,4,8,4">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind StatusGlyph}"
                                                      FontSize="17" />
                                            <TextBlock Text="{x:Bind StatusText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   MaximumRowsOrColumns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Visibility="{x:Bind ViewModel.NoRuntimeIssuesVisibility, Mode=OneWay}"
                                    Spacing="3">
                            <TextBlock Text="运行信息：无" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RuntimeIssues, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.RuntimeIssuesVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:RuntimeHealthIssueItem">
                                    <Grid ColumnSpacing="12" Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind ModuleName}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Message}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind OccurredAtText}"
                                                   Opacity="0.65" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource HomePageSectionHeaderSpacing}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="音频管理"
                               VerticalAlignment="Center"
                               Style="{StaticResource HomeSectionHeaderStyle}" />
                    <Button Grid.Column="1"
                            Width="84"
                            Content="添加"
                            Click="OnAddHotkeyCardClick" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Bluetooth.HotkeyCards, Mode=OneWay}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:HotkeyBindingCard">
                            <cardControls:HotkeyBindingCardControl
                                EditClicked="OnEditHotkeyCardClick"
                                DeleteClicked="OnDeleteHotkeyCardClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="{StaticResource HomePageSectionHeaderSpacing}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="快捷键管理"
                               VerticalAlignment="Center"
                               Style="{StaticResource HomeSectionHeaderStyle}" />
                    <Button Grid.Column="1"
                            Width="84"
                            Content="添加"
                            Click="OnAddHotkeyNotificationCardClick" />
                </Grid>
                <Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HotkeyNotifications.HotkeyCards, Mode=OneWay}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:HotkeyNotificationCard">
                                <cardControls:HotkeyNotificationCardControl
                                    EditClicked="OnEditHotkeyNotificationCardClick"
                                    DeleteClicked="OnDeleteHotkeyNotificationCardClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Style="{StaticResource HomeEmptyStateBorderStyle}"
                            Visibility="{x:Bind ViewModel.HotkeyNotifications.EmptyStateVisibility, Mode=OneWay}">
                        <TextBlock Text="暂无卡片，点击“添加”创建。"
                                   Style="{StaticResource HomeEmptyStateTextStyle}" />
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="{StaticResource HomePageSectionHeaderSpacing}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="自动化列表"
                               VerticalAlignment="Center"
                               Style="{StaticResource HomeSectionHeaderStyle}" />
                    <Button Grid.Column="1"
                            Width="84"
                            Content="添加"
                            Click="OnAddAutomationCardClick" />
                </Grid>
                <Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Automations.Automations, Mode=OneWay}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:AutomationListItem">
                                <cardControls:AutomationCardControl
                                    EditClicked="OnEditAutomationCardClick"
                                    TestClicked="OnTestAutomationCardClick"
                                    DeleteClicked="OnDeleteAutomationCardClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Style="{StaticResource HomeEmptyStateBorderStyle}"
                            Visibility="{x:Bind ViewModel.Automations.EmptyStateVisibility, Mode=OneWay}">
                        <TextBlock Text="暂无自动化，点击“添加”创建。"
                                   Style="{StaticResource HomeEmptyStateTextStyle}" />
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
