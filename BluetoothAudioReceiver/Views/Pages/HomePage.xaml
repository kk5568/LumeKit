<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:cardControls="using:BluetoothAudioReceiver.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="主页"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:HomePageViewModel}"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <x:Double x:Key="HomePageSectionSpacing">24</x:Double>
        <x:Double x:Key="HomePageSectionHeaderSpacing">10</x:Double>
        <Thickness x:Key="HomePageEmptyStatePadding">24</Thickness>
        <CornerRadius x:Key="HomePageEmptyStateCornerRadius">16</CornerRadius>
        <x:Double x:Key="HomePageEmptyStateOpacity">0.72</x:Double>

        <Style x:Key="HomeSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HomeEmptyStateBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource HomePageEmptyStatePadding}" />
            <Setter Property="CornerRadius" Value="{StaticResource HomePageEmptyStateCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="HomeEmptyStateTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{StaticResource HomePageEmptyStateOpacity}" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource HomePageSectionSpacing}">

            <StackPanel Spacing="{StaticResource HomePageSectionHeaderSpacing}">
                <TextBlock Text="音频管理"
                           Style="{StaticResource HomeSectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Bluetooth.HotkeyCards, Mode=OneWay}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:HotkeyBindingCard">
                            <cardControls:HotkeyBindingCardControl
                                EditClicked="OnEditHotkeyCardClick"
                                DeleteClicked="OnDeleteHotkeyCardClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="{StaticResource HomePageSectionHeaderSpacing}">
                <TextBlock Text="快捷键管理"
                           Style="{StaticResource HomeSectionHeaderStyle}" />
                <Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HotkeyNotifications.HotkeyCards, Mode=OneWay}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:HotkeyNotificationCard">
                                <cardControls:HotkeyNotificationCardControl
                                    EditClicked="OnEditHotkeyNotificationCardClick"
                                    DeleteClicked="OnDeleteHotkeyNotificationCardClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Style="{StaticResource HomeEmptyStateBorderStyle}"
                            Visibility="{x:Bind ViewModel.HotkeyNotifications.EmptyStateVisibility, Mode=OneWay}">
                        <TextBlock Text="暂无卡片，进入“快捷键管理”添加。"
                                   Style="{StaticResource HomeEmptyStateTextStyle}" />
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="{StaticResource HomePageSectionHeaderSpacing}">
                <TextBlock Text="自动化列表"
                           Style="{StaticResource HomeSectionHeaderStyle}" />
                <Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Automations.Automations, Mode=OneWay}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:AutomationListItem">
                                <cardControls:AutomationCardControl
                                    EditClicked="OnEditAutomationCardClick"
                                    TestClicked="OnTestAutomationCardClick"
                                    DeleteClicked="OnDeleteAutomationCardClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Style="{StaticResource HomeEmptyStateBorderStyle}"
                            Visibility="{x:Bind ViewModel.Automations.EmptyStateVisibility, Mode=OneWay}">
                        <TextBlock Text="暂无自动化，进入“自动化列表”新建。"
                                   Style="{StaticResource HomeEmptyStateTextStyle}" />
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
