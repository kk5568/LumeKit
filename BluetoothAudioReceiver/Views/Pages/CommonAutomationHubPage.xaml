<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.CommonAutomationHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="常用自动化"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:CommonAutomationHubPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,16,24,24"
                    Spacing="8">
            <Button Click="BluetoothEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE7F5;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="音频管理"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="蓝牙音频、连接行为和基础音量设置。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Click="HotkeyNotificationEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE765;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="快捷键管理"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="配置快捷键反馈、按键弹窗和相关提示行为。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
