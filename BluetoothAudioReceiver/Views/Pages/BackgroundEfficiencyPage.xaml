<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.BackgroundEfficiencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="电量管理"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:BackgroundEfficiencyPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <CornerRadius x:Key="BackgroundEfficiencyCardCornerRadius">4</CornerRadius>
        <Thickness x:Key="BackgroundEfficiencyPageMargin">24</Thickness>
        <Thickness x:Key="BackgroundEfficiencyCardPadding">12</Thickness>
        <x:Double x:Key="BackgroundEfficiencySectionTitleFontSize">16</x:Double>
        <x:Double x:Key="BackgroundEfficiencyPageTitleFontSize">24</x:Double>
        <x:Double x:Key="BackgroundEfficiencyBodyFontSize">14</x:Double>
        <x:Double x:Key="BackgroundEfficiencyRowSpacing">8</x:Double>
        <x:Double x:Key="BackgroundEfficiencyHeaderSpacing">8</x:Double>
        <x:Double x:Key="BackgroundEfficiencyHeaderToggleSpacing">10</x:Double>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource BackgroundEfficiencyPageMargin}"
                    Spacing="12">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BackgroundEfficiencyCardCornerRadius}"
                    Padding="{StaticResource BackgroundEfficiencyCardPadding}">
                <StackPanel Spacing="{StaticResource BackgroundEfficiencyRowSpacing}">
                    <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource BackgroundEfficiencySectionTitleFontSize}"
                               FontWeight="SemiBold" />

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="{x:Bind ViewModel.OverviewText, Mode=OneWay}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="{StaticResource BackgroundEfficiencyHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind ViewModel.MasterSwitchLabelText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}" />

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource BackgroundEfficiencyHeaderToggleSpacing}">
                            <TextBlock Text="{x:Bind ViewModel.OnLabelText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch IsOn="{x:Bind ViewModel.MasterSwitchEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          Margin="0"
                                          Padding="0"
                                          OnContent=""
                                          OffContent="" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.RulesTitleText, Mode=OneWay}"
                               Margin="0,4,0,0"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{x:Bind ViewModel.RuleLineOneText, Mode=OneWay}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="{x:Bind ViewModel.RuleLineTwoText, Mode=OneWay}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="{x:Bind ViewModel.RuleLineThreeText, Mode=OneWay}"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="{StaticResource BackgroundEfficiencyHeaderSpacing}"
                          RowSpacing="{StaticResource BackgroundEfficiencyRowSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Bind ViewModel.CurrentStatusLabelText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{x:Bind ViewModel.StatusDescription, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.WhitelistLabelText, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{x:Bind ViewModel.WhitelistCountText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                   TextWrapping="Wrap" />
                    </Grid>

                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BackgroundEfficiencyCardCornerRadius}"
                        Padding="{StaticResource BackgroundEfficiencyCardPadding}">
                    <StackPanel Spacing="{StaticResource BackgroundEfficiencyRowSpacing}">
                        <TextBlock Text="{x:Bind ViewModel.WhitelistTitleText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencySectionTitleFontSize}"
                                   FontWeight="SemiBold" />

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.WhitelistInstructionText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind ViewModel.ProcessWhitelistString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="220"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <Grid ColumnSpacing="{StaticResource BackgroundEfficiencyHeaderSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.WhitelistPreviewText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.RestoreButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnRestoreWhitelistDefaultClick" />

                            <Button Grid.Column="2"
                                    Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnSaveWhitelistClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BackgroundEfficiencyCardCornerRadius}"
                        Padding="{StaticResource BackgroundEfficiencyCardPadding}">
                    <StackPanel Spacing="{StaticResource BackgroundEfficiencyRowSpacing}">
                        <TextBlock Text="{x:Bind ViewModel.BlacklistTitleText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencySectionTitleFontSize}"
                                   FontWeight="SemiBold" />

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.BlacklistInstructionText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind ViewModel.ProcessBlacklistString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="220"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />

                        <Grid ColumnSpacing="{StaticResource BackgroundEfficiencyHeaderSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.BlacklistPreviewText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource BackgroundEfficiencyBodyFontSize}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.RestoreButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnRestoreBlacklistDefaultClick" />

                            <Button Grid.Column="2"
                                    Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                                    MinWidth="96"
                                    Click="OnSaveBlacklistClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
