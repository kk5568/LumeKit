<Page
    x:Name="RootPage"
    x:Class="BluetoothAudioReceiver.Views.Pages.AutomationEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:local="using:BluetoothAudioReceiver.Views.Pages"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="编辑自动化"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    Background="Transparent">

    <Page.Resources>
        <local:AutomationDisplayTextConverter x:Key="AutomationTextConverter" />
        <local:AutomationShortcutOptionConverter x:Key="AutomationShortcutOptionConverter" />
        <local:AutomationSectionKindVisibilityConverter x:Key="AutomationSectionKindVisibilityConverter" />
        <local:AutomationActionTitleVisibilityConverter x:Key="AutomationActionTitleVisibilityConverter" />
        <local:AutomationActionIconGlyphConverter x:Key="AutomationActionIconGlyphConverter" />

        <Thickness x:Key="EditorPagePadding">24</Thickness>
        <Thickness x:Key="NodeCardPadding">16</Thickness>
        <CornerRadius x:Key="NodeCardCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="SectionBadgeCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <x:Double x:Key="EditorMaxWidth">1200</x:Double>
        <x:Double x:Key="ParameterControlHeight">32</x:Double>
        <x:Double x:Key="ParameterSelectionBoxWidth">200</x:Double>
        <x:Double x:Key="ParameterTextBoxWidth">260</x:Double>
        <x:Double x:Key="ParameterControlMaxWidth">860</x:Double>
        <SolidColorBrush x:Key="SectionBadgeBrush" Color="#D9ECFF" />
        <SolidColorBrush x:Key="SectionBadgeBorderBrush" Color="#A9CFFF" />
        <SolidColorBrush x:Key="SectionBadgeForegroundBrush" Color="#0F5FB8" />

        <DataTemplate x:Key="ComboBoxTextItemTemplate">
            <TextBlock
                Text="{Binding Converter={StaticResource AutomationShortcutOptionConverter}}"
                FontFamily="Segoe UI Variable Text"
                FontSize="14"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </DataTemplate>

        <DataTemplate x:Key="RightAlignedComboBoxTextItemTemplate">
            <TextBlock
                Text="{Binding Converter={StaticResource AutomationShortcutOptionConverter}}"
                FontFamily="Segoe UI Variable Text"
                FontSize="14"
                HorizontalAlignment="Stretch"
                TextAlignment="Right"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </DataTemplate>

        <Style x:Key="RightAlignedComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="EditorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="{StaticResource ParameterControlHeight}" />
            <Setter Property="Width" Value="{StaticResource ParameterSelectionBoxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="ItemTemplate" Value="{StaticResource ComboBoxTextItemTemplate}" />
        </Style>

        <Style x:Key="AutomationPropertyComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="{StaticResource ParameterControlHeight}" />
            <Setter Property="Width" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="ItemTemplate" Value="{StaticResource RightAlignedComboBoxTextItemTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RightAlignedComboBoxItemStyle}" />
        </Style>

        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="{StaticResource ParameterControlHeight}" />
            <Setter Property="Width" Value="{StaticResource ParameterTextBoxWidth}" />
            <Setter Property="MaxWidth" Value="{StaticResource ParameterControlMaxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="ActionListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style x:Key="IconToolButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SectionActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <DataTemplate x:Key="InlineNodeTemplate" x:DataType="viewmodels:AutomationNode">
            <Border
                Margin="0,0,0,12"
                Padding="{StaticResource NodeCardPadding}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource NodeCardCornerRadius}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding Title, Converter={StaticResource AutomationTextConverter}}"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="15"
                            FontWeight="Medium" />

                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource EditorComboBoxStyle}"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=程序启动|程序退出|游戏模式|电源状态|蓝牙已连接|到达日出|到达日落}"
                            ItemsSource="{Binding ParameterOptions}"
                            SelectedItem="{Binding Subtitle, Mode=TwoWay}"
                            SelectionChanged="ParameterCombo_SelectionChanged" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=输出设备变化}">
                            <ComboBox
                                Height="{StaticResource ParameterControlHeight}"
                                Width="96"
                                HorizontalAlignment="Right"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ItemsSource="{Binding DataContext.OutputTriggerStateOptions, ElementName=RootPage}"
                                SelectedItem="{Binding SecondaryValue, Mode=TwoWay}" />

                            <ComboBox
                                Style="{StaticResource EditorComboBoxStyle}"
                                ItemsSource="{Binding ParameterOptions}"
                                SelectedItem="{Binding Subtitle, Mode=TwoWay}"
                                SelectionChanged="ParameterCombo_SelectionChanged" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=性能模式}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="窗口"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox
                                x:Name="PerformanceWindowModeComboBox"
                                Height="{StaticResource ParameterControlHeight}"
                                Width="112"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ItemsSource="{Binding DataContext.PerformanceWindowModeOptions, ElementName=RootPage}"
                                SelectedItem="{Binding PerformanceWindowMode, Mode=TwoWay}"
                                SelectionChanged="PerformanceWindowMode_SelectionChanged" />

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="GPU"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox
                                x:Name="PerformanceGpuComparisonComboBox"
                                Height="{StaticResource ParameterControlHeight}"
                                Width="80"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ItemsSource="{Binding DataContext.PerformanceGpuComparisonOptions, ElementName=RootPage}"
                                SelectedItem="{Binding PerformanceGpuComparison, Mode=TwoWay}"
                                SelectionChanged="PerformanceGpuComparison_SelectionChanged" />
                            <ComboBox
                                x:Name="PerformanceGpuUsageComboBox"
                                Height="{StaticResource ParameterControlHeight}"
                                Width="112"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ItemsSource="{Binding DataContext.PerformanceGpuUsageOptions, ElementName=RootPage}"
                                SelectedItem="{Binding PerformanceGpuUsage, Mode=TwoWay}"
                                SelectionChanged="PerformanceGpuUsage_SelectionChanged" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">
                        <Button
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="上移"
                            Click="MoveNodeUp_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE70E;" />
                        </Button>
                        <Button
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="下移"
                            Click="MoveNodeDown_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE70D;" />
                        </Button>
                        <Button
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="删除"
                            Click="RemoveNode_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActionCardTemplate" x:DataType="viewmodels:AutomationNode">
            <Border
                Margin="0,0,0,12"
                Padding="{StaticResource NodeCardPadding}"
                MinHeight="72"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource NodeCardCornerRadius}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="20"
                            Glyph="{Binding Title, Converter={StaticResource AutomationActionIconGlyphConverter}}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Title, Converter={StaticResource AutomationTextConverter}}"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="15"
                            FontWeight="Medium"
                            TextTrimming="CharacterEllipsis" />

                        <ComboBox
                            Grid.Column="2"
                            Style="{StaticResource EditorComboBoxStyle}"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=调整亮度|电源模式|深色模式|等待|音频输出|GHelper 快捷键|Win11 系统快捷键|触摸板}"
                            ItemsSource="{Binding ParameterOptions}"
                            SelectedItem="{Binding Subtitle, Mode=TwoWay}"
                            SelectionChanged="ParameterCombo_SelectionChanged" />

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=输入音频}">
                            <ComboBox
                                Height="{StaticResource ParameterControlHeight}"
                                Width="96"
                                HorizontalAlignment="Right"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                ItemsSource="{Binding DataContext.InputDeviceActionOptions, ElementName=RootPage}"
                                SelectedItem="{Binding SecondaryValue, Mode=TwoWay}" />

                            <ComboBox
                                Style="{StaticResource EditorComboBoxStyle}"
                                ItemsSource="{Binding ParameterOptions}"
                                SelectedItem="{Binding Subtitle, Mode=TwoWay}"
                                SelectionChanged="ParameterCombo_SelectionChanged" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Height="{StaticResource ParameterControlHeight}"
                            Width="{StaticResource ParameterSelectionBoxWidth}"
                            MaxWidth="{StaticResource ParameterControlMaxWidth}"
                            HorizontalAlignment="Right"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=启动程序|关闭程序}"
                            Click="PickExecutableForNode_Click">
                            <TextBlock
                                Text="{Binding Subtitle, Converter={StaticResource AutomationTextConverter}}"
                                TextTrimming="CharacterEllipsis" />
                        </Button>

                        <TextBox
                            Grid.Column="2"
                            Style="{StaticResource EditorTextBoxStyle}"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=打开网页}"
                            Text="{Binding RawValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="InlineText_TextChanged" />

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=自定义快捷键}">
                            <TextBox
                                Style="{StaticResource EditorTextBoxStyle}"
                                Width="{StaticResource ParameterTextBoxWidth}"
                                Text="{Binding RawValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="点击录制快捷键"
                                IsReadOnly="True"
                                TextChanged="InlineText_TextChanged" />

                            <Button
                                Height="{StaticResource ParameterControlHeight}"
                                MinWidth="72"
                                Content="录制"
                                Click="RecordHotkey_Click" />

                            <Button
                                Height="{StaticResource ParameterControlHeight}"
                                MinWidth="72"
                                Content="清除"
                                Click="ClearCustomHotkey_Click" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Visibility="{Binding Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=通知}">
                            <TextBox
                                Style="{StaticResource EditorTextBoxStyle}"
                                Width="{StaticResource ParameterTextBoxWidth}"
                                Text="{Binding RawValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="通知内容"
                                TextChanged="InlineText_TextChanged" />

                            <Button
                                Height="{StaticResource ParameterControlHeight}"
                                MinWidth="72"
                                Content="保存"
                                Click="SaveNotificationText_Click" />

                            <Button
                                Height="{StaticResource ParameterControlHeight}"
                                MinWidth="72"
                                Content="清除"
                                Click="ClearNotificationText_Click" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">
                        <Button
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="上移"
                            Click="MoveNodeUp_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE70E;" />
                        </Button>
                        <Button
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="下移"
                            Click="MoveNodeDown_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE70D;" />
                        </Button>
                        <Button
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="删除"
                            Click="RemoveNode_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="viewmodels:AutomationSectionViewModel">
            <StackPanel Margin="0,0,0,24" Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="14,8"
                        Background="{StaticResource SectionBadgeBrush}"
                        BorderBrush="{StaticResource SectionBadgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SectionBadgeCornerRadius}">
                        <TextBlock
                            Text="{Binding HeaderNode.Title, Converter={StaticResource AutomationTextConverter}}"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SectionBadgeForegroundBrush}" />
                    </Border>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource SectionActionButtonStyle}"
                        Visibility="{Binding HeaderNode.Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=如果}"
                        Click="AddInlineSectionItem_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="添加触发" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource SectionActionButtonStyle}"
                        Visibility="{Binding HeaderNode.Title, Converter={StaticResource AutomationActionTitleVisibilityConverter}, ConverterParameter=条件}"
                        Click="AddInlineSectionItem_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="添加条件" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource SectionActionButtonStyle}"
                        Visibility="{Binding HeaderNode.Title, Converter={StaticResource AutomationSectionKindVisibilityConverter}, ConverterParameter=Action}"
                        Click="AddSectionAction_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="添加动作" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl
                    Visibility="{Binding HeaderNode.Title, Converter={StaticResource AutomationSectionKindVisibilityConverter}, ConverterParameter=Inline}"
                    ItemsSource="{Binding ActionNodes}"
                    ItemTemplate="{StaticResource InlineNodeTemplate}" />

                <ListView
                    Visibility="{Binding HeaderNode.Title, Converter={StaticResource AutomationSectionKindVisibilityConverter}, ConverterParameter=Action}"
                    ItemsSource="{Binding ActionNodes}"
                    ItemTemplate="{StaticResource ActionCardTemplate}"
                    SelectionMode="None"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsCompleted="ActionList_DragItemsCompleted"
                    ItemContainerStyle="{StaticResource ActionListViewItemStyle}"
                    HorizontalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="{StaticResource EditorPagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Spacing="24">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Text="{Binding ViewModel.AutomationName, ElementName=RootPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="18"
                        FontWeight="Normal"
                        PlaceholderText="自动化名称" />

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Button Content="取消" Click="CancelAutomation_Click" />
                        <Button
                            MinWidth="88"
                            Content="保存"
                            IsEnabled="{Binding ViewModel.CanSavePipeline, ElementName=RootPage}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="SaveAutomation_Click" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl
                        ItemsSource="{Binding ViewModel.Sections, ElementName=RootPage}"
                        ItemTemplate="{StaticResource SectionTemplate}" />

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource NodeCardCornerRadius}">
                        <StackPanel Spacing="16">
                            <TextBlock
                                Text="自动化属性"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="悬浮通知" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Style="{StaticResource AutomationPropertyComboBoxStyle}"
                                    ItemsSource="{Binding ViewModel.SwitchOptions, ElementName=RootPage}"
                                    SelectedItem="{Binding ViewModel.ExecutionNotificationEnabledText, ElementName=RootPage, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开机后运行" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Style="{StaticResource AutomationPropertyComboBoxStyle}"
                                    ItemsSource="{Binding ViewModel.SwitchOptions, ElementName=RootPage}"
                                    SelectedItem="{Binding ViewModel.RunOnStartupEnabledText, ElementName=RootPage, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="只允许一次" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Style="{StaticResource AutomationPropertyComboBoxStyle}"
                                    ItemsSource="{Binding ViewModel.SwitchOptions, ElementName=RootPage}"
                                    SelectedItem="{Binding ViewModel.OnceOnlyEnabledText, ElementName=RootPage, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="冷却时间" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Style="{StaticResource AutomationPropertyComboBoxStyle}"
                                    ItemsSource="{Binding ViewModel.CooldownOptions, ElementName=RootPage}"
                                    SelectedItem="{Binding ViewModel.CooldownText, ElementName=RootPage, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="允许重复执行" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Style="{StaticResource AutomationPropertyComboBoxStyle}"
                                    ItemsSource="{Binding ViewModel.RepeatExecutionOptions, ElementName=RootPage}"
                                    SelectedItem="{Binding ViewModel.AllowRepeatedExecutionText, ElementName=RootPage, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="运行时段" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Style="{StaticResource AutomationPropertyComboBoxStyle}"
                                    ItemsSource="{Binding ViewModel.RunTimeModeOptions, ElementName=RootPage}"
                                    SelectedItem="{Binding ViewModel.RunTimeMode, ElementName=RootPage, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
