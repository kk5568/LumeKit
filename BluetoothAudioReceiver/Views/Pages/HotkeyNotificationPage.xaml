<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.HotkeyNotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:cardControls="using:BluetoothAudioReceiver.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="快捷键管理"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:HotkeyNotificationPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <x:Double x:Key="HotkeyNotificationPageSectionSpacing">16</x:Double>
        <x:Double x:Key="HotkeyNotificationPageActionButtonSpacing">8</x:Double>
        <Thickness x:Key="HotkeyNotificationPageEmptyStatePadding">24</Thickness>
        <CornerRadius x:Key="HotkeyNotificationPageEmptyStateCornerRadius">16</CornerRadius>
        <x:Double x:Key="HotkeyNotificationPageEmptyStateOpacity">0.72</x:Double>

        <Style x:Key="HotkeyEmptyStateBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource HotkeyNotificationPageEmptyStatePadding}" />
            <Setter Property="CornerRadius" Value="{StaticResource HotkeyNotificationPageEmptyStateCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="HotkeyEmptyStateTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="{StaticResource HotkeyNotificationPageEmptyStateOpacity}" />
        </Style>

    </Page.Resources>

    <ScrollViewer Padding="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource HotkeyNotificationPageSectionSpacing}">
            <Button Content="添加"
                    Click="OnAddCardClick"
                    Width="84"
                    HorizontalAlignment="Right" />

            <Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.HotkeyCards, Mode=OneWay}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:HotkeyNotificationCard">
                            <cardControls:HotkeyNotificationCardControl
                                EditClicked="OnEditCardClick"
                                DeleteClicked="OnDeleteCardClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Style="{StaticResource HotkeyEmptyStateBorderStyle}"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                    <TextBlock Text="暂无卡片，点击“添加”创建。"
                               Style="{StaticResource HotkeyEmptyStateTextStyle}" />
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
