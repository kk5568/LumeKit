<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.OtherSettingsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="其他设置"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:OtherSettingsHubPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,16,24,24"
                    Spacing="8">
            <Button Click="NotificationEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE7F4;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="悬浮通知"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="管理提示出现条件，以及游戏、全屏和录屏场景行为。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
