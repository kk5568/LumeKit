<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.AutomationBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="自动化设置"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutomationBuilderPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="自动化设置"
                       FontFamily="Segoe UI Variable Text"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="编辑入口已统一到自动化编辑页。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="打开编辑页"
                    MinWidth="120"
                    Click="OpenEditor_Click" />
        </StackPanel>
    </Grid>
</Page>
