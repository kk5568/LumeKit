<Page x:Class="BluetoothAudioReceiver.Views.Pages.IslandPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
      behaviors:NavigationViewHeaderBehavior.HeaderContext="超级岛"
      behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
      d:DataContext="{d:DesignInstance Type=viewmodels:IslandPageViewModel}"
      mc:Ignorable="d"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource ScrollViewerContentPadding}" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Text="超级岛" Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" />
            <controls:SettingsCard Header="启用超级岛" Description="窗口最小化时，在屏幕顶部显示与悬浮通知相同样式的提示窗口。">
                <ToggleSwitch IsOn="{x:Bind ViewModel.IslandEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="测试超级岛" Description="点击显示，再次点击关闭，用于预览当前设置。">
                <Button Content="测试" Command="{x:Bind ViewModel.TestIslandCommand}" MinWidth="88" HorizontalAlignment="Right" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="背景材质" Description="只影响超级岛，不改变普通悬浮通知；修改后重新打开测试预览生效。">
                <ComboBox MinWidth="140"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          SelectedItem="{x:Bind ViewModel.IslandMaterialType, Mode=TwoWay}"
                          ItemsSource="{x:Bind ViewModel.IslandMaterialTypeOptions}" />
            </controls:SettingsCard>
            <TextBlock Text="自动亮度" Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" />
            <controls:SettingsCard Header="显示自动亮度状态" Description="自动亮度完成调整后，在超级岛显示状态。">
                <ToggleSwitch IsOn="{x:Bind ViewModel.IslandAutoBrightnessStatusEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="显示亮度与色温" Description="在自动亮度状态中显示实际亮度百分比和色温。"
                                    IsEnabled="{x:Bind ViewModel.IslandAutoBrightnessStatusEnabled, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.IslandAutoBrightnessDetailsEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" />
            </controls:SettingsCard>
            <TextBlock Text="外观设置" Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" />
            <controls:SettingsCard Header="预设" Description="选择一种固定样式；选择自定义后可调整下方参数。">
                <ComboBox Width="180"
                          HorizontalAlignment="Right"
                          SelectedValuePath="Tag"
                          SelectedValue="{x:Bind ViewModel.IslandLayoutPreset, Mode=TwoWay}">
                    <ComboBoxItem Content="紧凑" Tag="Compact" />
                    <ComboBoxItem Content="标准" Tag="Standard" />
                    <ComboBoxItem Content="宽屏" Tag="Wide" />
                    <ComboBoxItem Content="自定义" Tag="Custom" />
                </ComboBox>
            </controls:SettingsCard>
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <controls:SettingsCard Header="宽度" Description="超级岛的横向大小。" IsEnabled="{x:Bind ViewModel.IsCustomLayout, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" MinWidth="240" Spacing="12" VerticalAlignment="Center">
                        <Slider Width="180" Minimum="180" Maximum="600" StepFrequency="1" Value="{x:Bind ViewModel.IslandWidth, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.IslandWidthText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="48" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="高度" Description="超级岛的纵向大小。" IsEnabled="{x:Bind ViewModel.IsCustomLayout, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" MinWidth="240" Spacing="12" VerticalAlignment="Center">
                        <Slider Width="180" Minimum="40" Maximum="180" StepFrequency="1" Value="{x:Bind ViewModel.IslandHeight, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.IslandHeightText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="48" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="顶部距离" Description="超级岛距离屏幕顶部的距离。" IsEnabled="{x:Bind ViewModel.IsCustomLayout, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" MinWidth="240" Spacing="12" VerticalAlignment="Center">
                        <Slider Width="180" Minimum="0" Maximum="300" StepFrequency="1" Value="{x:Bind ViewModel.IslandTopMargin, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.IslandTopMarginText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="48" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="水平位置" Description="选择超级岛在屏幕顶部的摆放位置。" IsEnabled="{x:Bind ViewModel.IsCustomLayout, Mode=OneWay}">
                    <ComboBox Width="180"
                              HorizontalAlignment="Right"
                              SelectedValuePath="Tag"
                              SelectedValue="{x:Bind ViewModel.IslandHorizontalPosition, Mode=TwoWay}">
                        <ComboBoxItem Content="居中" Tag="Center" />
                        <ComboBoxItem Content="左侧" Tag="Left" />
                        <ComboBoxItem Content="右侧" Tag="Right" />
                        <ComboBoxItem Content="自定义偏移" Tag="Custom" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard Header="水平偏移" Description="仅在“自定义偏移”时生效，正数向右，负数向左。" IsEnabled="{x:Bind ViewModel.IsCustomLayout, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" MinWidth="240" Spacing="12" VerticalAlignment="Center">
                        <Slider Width="180" Minimum="-600" Maximum="600" StepFrequency="1" Value="{x:Bind ViewModel.IslandHorizontalOffset, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.IslandHorizontalOffsetText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="48" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
            <TextBlock Text="状态来源会逐步接入；这些设置不会影响自动亮度本身或默认通知。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </ScrollViewer>
</Page>
