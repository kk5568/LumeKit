<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.AutoBrightnessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="Shell_AutoBrightness.Content"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutoBrightnessPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <CornerRadius x:Key="AutoBrightnessCardCornerRadius">4</CornerRadius>
        <Thickness x:Key="AutoBrightnessPageMargin">24</Thickness>
        <Thickness x:Key="AutoBrightnessCardPadding">12</Thickness>
        <x:Double x:Key="AutoBrightnessPageTitleFontSize">24</x:Double>
        <x:Double x:Key="AutoBrightnessSectionTitleFontSize">16</x:Double>
        <x:Double x:Key="AutoBrightnessBodyFontSize">14</x:Double>
        <x:Double x:Key="AutoBrightnessRowSpacing">8</x:Double>
        <x:Double x:Key="AutoBrightnessHeaderSpacing">8</x:Double>
        <x:Double x:Key="AutoBrightnessHeaderToggleSpacing">10</x:Double>
        <x:Double x:Key="AutoBrightnessSelectionBoxWidth">200</x:Double>
        <x:Double x:Key="AutoBrightnessShortcutInputWidth">260</x:Double>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource AutoBrightnessPageMargin}"
                    Spacing="12">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <StackPanel Spacing="{StaticResource AutoBrightnessRowSpacing}">
                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="亮度管理"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessSectionTitleFontSize}"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                            <TextBlock Text="开"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch IsOn="{x:Bind ViewModel.BrightnessEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          Margin="0"
                                          Padding="0"
                                          OnContent=""
                                          OffContent="" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最小亮度"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  Width="{StaticResource AutoBrightnessSelectionBoxWidth}"
                                  ItemsSource="{Binding BrightnessMinimumOptions}"
                                  SelectedIndex="{Binding SelectedMinimumBrightnessIndex, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大亮度"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  Width="{StaticResource AutoBrightnessSelectionBoxWidth}"
                                  ItemsSource="{Binding BrightnessMaximumOptions}"
                                  SelectedIndex="{Binding SelectedMaximumBrightnessIndex, Mode=TwoWay}" />
                    </Grid>

                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <StackPanel Spacing="{StaticResource AutoBrightnessRowSpacing}">
                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="色温管理"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessSectionTitleFontSize}"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                            <TextBlock Text="开"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch IsOn="{Binding ColorTemperatureEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          Margin="0"
                                          Padding="0"
                                          OnContent=""
                                          OffContent="" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最低色温"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  Width="{StaticResource AutoBrightnessSelectionBoxWidth}"
                                  ItemsSource="{Binding ColorTemperatureMinimumOptions}"
                                  SelectedIndex="{Binding SelectedMinimumColorTemperatureIndex, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最高色温"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  Width="{StaticResource AutoBrightnessSelectionBoxWidth}"
                                  ItemsSource="{Binding ColorTemperatureMaximumOptions}"
                                  SelectedIndex="{Binding SelectedMaximumColorTemperatureIndex, Mode=TwoWay}" />
                    </Grid>

                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="设置快捷键"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource AutoBrightnessBodyFontSize}" />

                    <TextBox x:Name="ShortcutCaptureTextBox"
                             Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             Width="{StaticResource AutoBrightnessShortcutInputWidth}"
                             Text="{Binding CustomShortcutText, Mode=TwoWay}"
                             IsReadOnly="True"
                             PlaceholderText="例如：Ctrl + Alt + B" />

                    <Button Grid.Column="2"
                            Content="录制"
                            MinWidth="72"
                            Click="OnApplyShortcutClick" />

                    <Button Grid.Column="3"
                            Content="保存"
                            MinWidth="72"
                            Click="OnSaveShortcutClick" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <StackPanel Spacing="{StaticResource AutoBrightnessRowSpacing}">
                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="前后台变化自动亮度"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}" />

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                            <TextBlock Text="开"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch IsOn="{Binding AutoBrightnessOnForegroundEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          Margin="0"
                                          Padding="0"
                                          OnContent=""
                                          OffContent="" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="前后台变化冷却时间"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  Width="{StaticResource AutoBrightnessSelectionBoxWidth}"
                                  ItemsSource="{Binding ForegroundCooldownOptions}"
                                  SelectedItem="{Binding SelectedForegroundCooldownText, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="前后台变化悬浮通知"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}" />
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                            <TextBlock Text="{Binding ForegroundNotificationStatusText}"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Text"
                                       FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch IsOn="{Binding AutoBrightnessOnForegroundNotificationEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          MinWidth="0"
                                          Margin="0"
                                          Padding="0"
                                          OnContent=""
                                          OffContent="" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="悬浮通知"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource AutoBrightnessBodyFontSize}" />

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                        <TextBlock Text="开"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsOn="{Binding AutoBrightnessNotificationEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      MinWidth="0"
                                      Margin="0"
                                      Padding="0"
                                      OnContent=""
                                      OffContent="" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="解锁自动亮度"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource AutoBrightnessBodyFontSize}" />

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                        <TextBlock Text="开"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsOn="{Binding AutoBrightnessOnUnlockEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      MinWidth="0"
                                      Margin="0"
                                      Padding="0"
                                      OnContent=""
                                      OffContent="" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="解锁自动亮度通知"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource AutoBrightnessBodyFontSize}" />

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                        <TextBlock Text="开"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsOn="{Binding AutoBrightnessOnUnlockNotificationEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      MinWidth="0"
                                      Margin="0"
                                      Padding="0"
                                      OnContent=""
                                      OffContent="" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="禁用系统夜灯"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource AutoBrightnessBodyFontSize}" />

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                        <TextBlock Text="开"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsOn="{Binding DisableNightLightEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      MinWidth="0"
                                      Margin="0"
                                      Padding="0"
                                      OnContent=""
                                      OffContent="" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AutoBrightnessCardCornerRadius}"
                    Padding="{StaticResource AutoBrightnessCardPadding}">
                <Grid ColumnSpacing="{StaticResource AutoBrightnessHeaderSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="夜间模式关闭色温调节"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="{StaticResource AutoBrightnessBodyFontSize}" />

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource AutoBrightnessHeaderToggleSpacing}">
                        <TextBlock Text="开"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="{StaticResource AutoBrightnessBodyFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch IsOn="{Binding DisableNightLightAtNightEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      MinWidth="0"
                                      Margin="0"
                                      Padding="0"
                                      OnContent=""
                                      OffContent="" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
