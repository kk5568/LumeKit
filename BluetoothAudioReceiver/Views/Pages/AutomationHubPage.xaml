<Page
    x:Class="BluetoothAudioReceiver.Views.Pages.AutomationHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:BluetoothAudioReceiver.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:BluetoothAudioReceiver.ViewModels.Pages"
    behaviors:NavigationViewHeaderBehavior.HeaderContext="自动化"
    behaviors:NavigationViewHeaderBehavior.HeaderLocalize="False"
    d:DataContext="{d:DesignInstance Type=viewmodels:AutomationHubPageViewModel}"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,16,24,24"
                    Spacing="8">
            <Button Click="CommonAutomationEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE8FD;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="常用自动化"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="音频、快捷键等日常自动化的快捷入口。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Click="CustomAutomationEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE710;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="自定义自动化"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="按触发条件和动作自定义自动化规则。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Click="GameListEntry_Click"
                    Style="{StaticResource HubItemButtonStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE8B7;"
                              FontSize="24"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Spacing="2">
                        <TextBlock Text="程序清单"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="维护参与自动化的程序名单，支持扫描和手动添加。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <FontIcon Grid.Column="2"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE76C;"
                              FontSize="16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
