<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Grid  -->
    <Style x:Key="CardPanelStyle" TargetType="Grid">
        <Style.Setters>
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style.Setters>
    </Style>

    <!--  TextBlock  -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="FontSize" Value="{StaticResource LargeFontSize}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource MediumFontSize}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="ListTitleStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style
        x:Key="ListSubTitleStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style
        x:Key="DetailSubTitleStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiLight" />
    </Style>

    <Style
        x:Key="DetailBodyBaseMediumStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
    </Style>

    <Style
        x:Key="DetailBodyStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="AppendTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--  Style (inc. the correct spacing) of a section header  -->
    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Style.Setters>
            <Setter Property="Margin" Value="1 10 0 5" />
        </Style.Setters>
    </Style>

    <x:Double x:Key="SharedFeatureCardWidth">286</x:Double>
    <x:Double x:Key="SharedFeatureCardHeaderHeight">40</x:Double>
    <x:Double x:Key="SharedFeatureCardDividerHeight">1</x:Double>
    <x:Double x:Key="SharedFeatureCardFooterHeight">36</x:Double>
    <GridLength x:Key="SharedFeatureCardHeaderGridLength">40</GridLength>
    <GridLength x:Key="SharedFeatureCardDividerGridLength">1</GridLength>
    <GridLength x:Key="SharedFeatureCardFooterGridLength">36</GridLength>
    <x:Double x:Key="SharedFeatureCardRowSpacing">12</x:Double>
    <x:Double x:Key="SharedFeatureCardActionSpacing">8</x:Double>
    <x:Double x:Key="SharedFeatureCardHeight">300</x:Double>
    <Thickness x:Key="SharedFeatureCardPadding">16</Thickness>
    <x:Double x:Key="SharedFeatureCardHeaderColumnSpacing">10</x:Double>

    <Style x:Key="SharedFeatureCardShellStyle" TargetType="Grid" BasedOn="{StaticResource CardPanelStyle}">
        <Setter Property="Width" Value="{StaticResource SharedFeatureCardWidth}" />
        <Setter Property="Height" Value="{StaticResource SharedFeatureCardHeight}" />
        <Setter Property="Padding" Value="{StaticResource SharedFeatureCardPadding}" />
        <Setter Property="Margin" Value="0,0,20,16" />
    </Style>

    <Style x:Key="SharedFeatureCardBadgeStyle" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style x:Key="SharedFeatureCardBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SharedFeatureCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SharedFeatureCardStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SharedFeatureCardActionPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource SharedFeatureCardActionSpacing}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SharedFeatureCardDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="{StaticResource SharedFeatureCardDividerHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

</ResourceDictionary>
