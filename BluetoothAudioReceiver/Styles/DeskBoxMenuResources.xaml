<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="WidgetTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="WidgetTextSecondaryBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="WidgetDividerBrush" Color="#D0D0D0" />
            <SolidColorBrush x:Key="WidgetOverlaySurfaceBrush" Color="#FBFCFD" />
            <SolidColorBrush x:Key="WidgetOverlayStrokeBrush" Color="#24000000" />
            <SolidColorBrush x:Key="WidgetLayerFillBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="WidgetLayerStrokeBrush" Color="#16000000" />
            <SolidColorBrush x:Key="WidgetTitleStateHoverBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="WidgetTitleStatePressedBrush" Color="#18000000" />
            <SolidColorBrush x:Key="WidgetTitleStateOpenBrush" Color="#14000000" />
            <SolidColorBrush x:Key="WidgetAccentWashBrush" Color="#160067C0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="WidgetTextBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="WidgetTextSecondaryBrush" Color="#A5A5A5" />
            <SolidColorBrush x:Key="WidgetDividerBrush" Color="#3C3C3C" />
            <SolidColorBrush x:Key="WidgetOverlaySurfaceBrush" Color="#2A3038" />
            <SolidColorBrush x:Key="WidgetOverlayStrokeBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="WidgetLayerFillBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="WidgetLayerStrokeBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="WidgetTitleStateHoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="WidgetTitleStatePressedBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="WidgetTitleStateOpenBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="WidgetAccentWashBrush" Color="#260078D4" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Directly carried over from DeskBox App.xaml for shared tray menus. -->
    <FontFamily x:Key="DeskBoxMenuFontFamily">Microsoft YaHei UI, Segoe UI Variable, Segoe UI</FontFamily>
    <CornerRadius x:Key="WidgetCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="WidgetCornerRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="WidgetCornerRadiusLarge">8</CornerRadius>
    <x:Double x:Key="WidgetSpacingXSmall">4</x:Double>
    <x:Double x:Key="WidgetSpacingSmall">8</x:Double>
    <x:Double x:Key="WidgetSpacingMedium">12</x:Double>
    <x:Double x:Key="WidgetSpacingLarge">16</x:Double>
    <x:Double x:Key="WidgetTitleTextSize">14</x:Double>
    <x:Double x:Key="WidgetBodyTextSize">14</x:Double>
    <x:Double x:Key="WidgetCaptionTextSize">12</x:Double>
    <x:Double x:Key="WidgetMotionFasterMilliseconds">83</x:Double>
    <x:Double x:Key="WidgetMotionFastMilliseconds">167</x:Double>
    <x:Double x:Key="WidgetMotionNormalMilliseconds">250</x:Double>
    <x:Double x:Key="DeskBoxMenuPresenterVerticalPadding">4</x:Double>
    <x:Double x:Key="DeskBoxMenuItemMinHeight">36</x:Double>
    <x:Double x:Key="DeskBoxMenuItemFontSize">13</x:Double>
    <Thickness x:Key="DeskBoxMenuPresenterPadding">0,4,0,4</Thickness>
    <Thickness x:Key="DeskBoxMenuItemPadding">10,8,10,8</Thickness>

    <!-- Shared DeskBox floating surface values. -->
    <x:Double x:Key="DeskBoxFloatingCornerRadius">8</x:Double>
    <x:Double x:Key="DeskBoxFloatingBorderOpacity">48</x:Double>
    <x:Double x:Key="DeskBoxFloatingOpacity">204</x:Double>
    <Thickness x:Key="DeskBoxFloatingPadding">14,0,14,0</Thickness>
    <x:Double x:Key="DeskBoxTestWidth">250</x:Double>
    <x:Double x:Key="DeskBoxTestHeight">54</x:Double>
    <x:Double x:Key="DeskBoxFloatingShowOffsetY">30</x:Double>
    <x:Double x:Key="DeskBoxFloatingShowDurationMs">300</x:Double>
    <x:Double x:Key="DeskBoxFloatingHideDurationMs">200</x:Double>

    <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DeskBoxMenuFontFamily}" />
        <Setter Property="Padding" Value="{StaticResource DeskBoxMenuPresenterPadding}" />
    </Style>

    <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DeskBoxMenuFontFamily}" />
        <Setter Property="MinHeight" Value="{StaticResource DeskBoxMenuItemMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource DeskBoxMenuItemPadding}" />
        <Setter Property="FontSize" Value="{StaticResource DeskBoxMenuItemFontSize}" />
    </Style>

    <Style TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DeskBoxMenuFontFamily}" />
        <Setter Property="MinHeight" Value="{StaticResource DeskBoxMenuItemMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource DeskBoxMenuItemPadding}" />
        <Setter Property="FontSize" Value="{StaticResource DeskBoxMenuItemFontSize}" />
    </Style>

    <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DeskBoxMenuFontFamily}" />
        <Setter Property="MinHeight" Value="{StaticResource DeskBoxMenuItemMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource DeskBoxMenuItemPadding}" />
        <Setter Property="FontSize" Value="{StaticResource DeskBoxMenuItemFontSize}" />
    </Style>
</ResourceDictionary>
