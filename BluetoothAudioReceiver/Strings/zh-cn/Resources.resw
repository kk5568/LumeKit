  <data name="DefaultProcessWhitelist" xml:space="preserve"><value>// 每行一个进程名
// 每行中双斜杠以及之后的内容会被忽略
// 支持 "?" 和 "*" 通配符

// 排除我们自己
BluetoothAudioReceiver.exe
// UWP Frame 有特别处理, 不应该被限制
ApplicationFrameHost.exe
// 系统 shell
dwm.exe
explorer.exe
ShellExperienceHost.exe
StartMenuExperienceHost.exe
SearchHost.exe
sihost.exe
fontdrvhost.exe
LockApp.exe
TabTip.exe
// 输入法
ChsIME.exe
ctfmon.exe
// 系统服务 - 它们会自己管理好资源
csrss.exe
smss.exe
svchost.exe
// WUDF
WUDFRd.exe</value></data>
  <data name="DefaultProcessBlacklist" xml:space="preserve"><value>// 每行一个进程名
// 命中的程序会额外强制进入效率模式
// 支持 "?" 和 "*" 通配符

msedge.exe
steam.exe
steamwebhelper.exe
UplayWebCore.exe
OneDrive.Sync.Service.exe
XiaomiPcManager.exe
SearchIndexer.exe
clash-verge.exe
GHelper.exe
ArmouryCrate.exe
ArmourySocketServer.exe
MSPCManager.exe
MSPCManagerService.exe
</value></data>
