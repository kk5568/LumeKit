  <data name="DefaultProcessWhitelist" xml:space="preserve"><value>// One process name per line
// Double slash and content after it in each line will be ignored
// Supports "?" and "*" wildcards

// Exclude ourselves
BluetoothAudioReceiver.exe
// UWP Frame has special handling and should not be throttled
ApplicationFrameHost.exe
// System shell
dwm.exe
explorer.exe
ShellExperienceHost.exe
StartMenuExperienceHost.exe
SearchHost.exe
sihost.exe
fontdrvhost.exe
LockApp.exe
TabTip.exe
// Input method
ChsIME.exe
ctfmon.exe
// System services - they manage their own resources well
csrss.exe
smss.exe
svchost.exe
// WUDF
WUDFRd.exe</value></data>
  <data name="DefaultProcessBlacklist" xml:space="preserve"><value>// One process name per line
// Matched processes are additionally forced into efficiency mode
// Supports "?" and "*" wildcards

msedge.exe
steam.exe
steamwebhelper.exe
UplayWebCore.exe
OneDrive.Sync.Service.exe
XiaomiPcManager.exe
SearchIndexer.exe
clash-verge.exe
GHelper.exe
ArmouryCrate.exe
ArmourySocketServer.exe
MSPCManager.exe
MSPCManagerService.exe
</value></data>
